#!/usr/bin/env python3
"""ds: 文章を AI に渡して結果の文章を受け取る（読み取り専用）。

無料の AI だけを使う。まず Groq に送り、混んでいたら Groq の別の無料モデルに切り替える。
ほかの予備はキーを保存したものだけ使う（bash bin/install-ds.sh --add openrouter など）:
  OpenRouter（無料のモデルだけ）→ Gemini → Cerebras（カード登録が必要で、無料は登録後30日の $5 分だけ）
有料のモデル・DeepSeek・GLM には送らない。
呼び出し方は従来の ds と同じ:
  cat 資料.txt | ds "要点を10行で"
  ds "2つの違いを表で" a.md b.md
  ds --max 1500 "エラーを原因ごとに" < app.log

終了コード（従来の ds とそろえる）: 2 キー未設定 / 3 API エラー / 4 送信禁止 / 5 上限で答えが出ない
失敗したら Claude が自分で行う（CLAUDE.md）。

設定（環境変数）:
  DS_QUIET=1      送信先の表示（標準エラー）を消す
  DS_ORDER        送る順番を変える（例: "groq,openrouter"）。既定 groq
予備の AI のキーとモデルは ~/.config/ds/<名前>.key と <名前>.model（install-ds.sh が保存する）
"""

import json
import os
import re
import select
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
QUIET = os.environ.get("DS_QUIET") == "1"
DEFAULT_MAX = 800
# 考える過程にも出力トークンを使うモデルがある。無料なので余裕を足して、答えが途中で切れないようにする
THINKING_HEADROOM = 4096
TIMEOUT = 300
# 無料枠は同時に 1 件まで。並列で呼ばれて 429 になったら、この秒数ずつ待ってやり直す
RETRY_WAITS = [] if os.environ.get("DS_RETRY") == "0" else [3, 6, 12]  # DS_RETRY=0 なら待たずに次の AI へ

# 送信禁止（外部の AI に送るため。CLAUDE.md「DeepSeek・GLM（と予備の AI）に渡さないもの」）
SECRET_PATTERNS = [
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"\bsk-[A-Za-z0-9_-]{20,}",
    r"\bAKIA[0-9A-Z]{16}\b",
    r"\bgh[pousr]_[A-Za-z0-9]{30,}",
    r"\bgithub_pat_[A-Za-z0-9_]{30,}",
    r"\bxox[abprs]-[A-Za-z0-9-]{10,}",
    r"\bAIza[0-9A-Za-z_-]{35}\b",
    r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.",
    r"(?i)\b(password|passwd|secret|api[_-]?key|access[_-]?token)\s*[:=]\s*\S{6,}",
    r"(マイナンバー|個人番号|口座番号)\D{0,10}\d{4,}",
]


def log(msg):
    if not QUIET:
        print(f"[ds] {msg}", file=sys.stderr)


def die(code, msg):
    print(f"ds: {msg}", file=sys.stderr)
    sys.exit(code)


def parse_args(argv):
    max_tokens = DEFAULT_MAX
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--max" and i + 1 < len(argv):
            try:
                max_tokens = int(argv[i + 1])
            except ValueError:
                die(1, f"--max には数を指定してください: {argv[i + 1]}")
            i += 2
            continue
        rest.append(a)
        i += 1
    if not rest:
        die(1, '使い方: ds [--max N] "指示" [ファイル...] [< 入力]')
    return max_tokens, rest[0], rest[1:]


# 認証情報の置き場所。ファイルとして渡されても送らない
SENSITIVE_DIRS = {".ssh", ".aws", ".gnupg", ".kube", ".docker", ".config"}
SENSITIVE_NAMES = {".env", ".netrc", ".npmrc", ".pgpass", "id_rsa", "id_ed25519", "credentials"}


def check_forbidden(paths, texts):
    # シンボリックリンクで 10_Life を迂回されないよう、実体のパスで調べる
    for p in [os.getcwd()] + [os.path.realpath(p) for p in paths]:
        parts = p.split(os.sep)
        if "10_Life" in parts:
            die(4, f"10_Life 配下は送れません: {p}")
    for p in (os.path.realpath(p) for p in paths):
        parts = p.split(os.sep)
        if SENSITIVE_DIRS & set(parts) or os.path.basename(p) in SENSITIVE_NAMES or os.path.basename(p).startswith(".env"):
            die(4, f"認証情報の置き場所らしいファイルは送れません: {p}")
    for t in texts:
        for pat in SECRET_PATTERNS:
            if re.search(pat, t):
                die(4, "秘密情報らしき内容が含まれるため送りません")


# 予備の AI（OpenAI 互換の chat/completions）。キーのファイルがあるものだけ使う
BACKUPS = {
    # 上限はモデルごとに別。混んでいたら fallback のモデルに切り替える（どれも無料枠）
    "groq": {"label": "Groq", "base": "https://api.groq.com/openai/v1", "model": "openai/gpt-oss-120b",
             "fallback": ["openai/gpt-oss-20b"]},
    # openrouter/free は無料のモデルを自動で選ぶ
    "openrouter": {"label": "OpenRouter", "base": "https://openrouter.ai/api/v1", "model": "openrouter/free"},
    # 無料枠では送った内容が Google の改善に使われ、人が読むこともある
    "gemini": {"label": "Gemini", "base": "https://generativelanguage.googleapis.com/v1beta/openai", "model": "gemini-2.5-flash"},
    "cerebras": {"label": "Cerebras", "base": "https://api.cerebras.ai/v1", "model": "gpt-oss-120b"},
}
# API キーを送る先は各社の公式ホストだけ（環境変数で別のサーバーに差し替えられてもキーを渡さない）
ALLOWED_HOSTS = {"api.groq.com", "openrouter.ai",
                 "generativelanguage.googleapis.com", "api.cerebras.ai"}
DS_CONF = os.path.join(HOME, ".config/ds")
ORDER = [x.strip() for x in os.environ.get("DS_ORDER", "groq").split(",") if x.strip()]


class Fail(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def read_file(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def backup_settings(name):
    """予備の AI の (キー, モデル)。キーがなければ None。"""
    key = read_file(os.path.join(DS_CONF, f"{name}.key"))
    if not key:
        return None
    model = read_file(os.path.join(DS_CONF, f"{name}.model")) or BACKUPS[name]["model"]
    # OpenRouter は無料のモデル（名前が :free で終わるか openrouter/free）だけ。ほかは料金がかかることがある
    if name == "openrouter" and not (model.endswith(":free") or model == "openrouter/free"):
        raise Fail(1, f"OpenRouter は無料のモデルだけ使えます: {model}")
    return key, model


def read_stdin(wait):
    """標準入力を読む。ファイルを渡したときは、入力がすぐ来なければ待たない（止まったままになるのを防ぐ）。"""
    if sys.stdin.isatty():
        return ""
    if not wait:
        ready, _, _ = select.select([sys.stdin], [], [], 0.5)
        if not ready:
            return ""
    return sys.stdin.read()


def build_message(instruction, files, stdin_text):
    parts = [instruction]
    for name, body in files:
        parts.append(f"\n--- ファイル: {name} ---\n{body}")
    if stdin_text:
        parts.append(f"\n--- 入力 ---\n{stdin_text}")
    return "\n".join(parts)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def call_chat(label, base, key, model, message, max_tokens, waits=None):
    body = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": message}],
        # 考える過程にも出力トークンを使うモデルがあるので、余裕を足して答えが途中で切れないようにする
        "max_tokens": max_tokens + THINKING_HEADROOM,
        "stream": False,
    }).encode("utf-8")
    url = f"{base}/chat/completions"
    parsed = urllib.parse.urlparse(url)
    # 公式ホストの https だけに送る
    if parsed.scheme != "https" or parsed.hostname not in ALLOWED_HOSTS:
        raise Fail(1, f"{label} の送り先 {parsed.hostname} は使えません（{', '.join(sorted(ALLOWED_HOSTS))} の https だけ）")
    req = urllib.request.Request(
        url,
        data=body,
        # Python 標準の User-Agent は Groq の手前の Cloudflare に止められる（403 error code 1010）ので名乗る
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json", "User-Agent": "ds-cli/1.0"},
    )
    # リダイレクトは辿らない（キーを別のホストへ持ち出さないため）
    opener = urllib.request.build_opener(_NoRedirect)
    for wait in (RETRY_WAITS if waits is None else waits) + [None]:
        try:
            with opener.open(req, timeout=TIMEOUT) as res:
                data = json.load(res)
            break
        except urllib.error.HTTPError as e:
            if e.code == 429 and wait is not None:
                log(f"同時実行の上限のため {wait} 秒待ってやり直します")
                time.sleep(wait)
                continue
            detail = e.read().decode("utf-8", "replace")[:200]
            raise Fail(3, f"{label} エラー {e.code}: {detail}")
        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as e:
            raise Fail(3, f"{label} に接続できません: {e}")

    try:
        choice = data["choices"][0]
        content = (choice["message"].get("content") or "").strip()
    except (KeyError, IndexError, TypeError):
        raise Fail(3, f"{label} の応答の形が想定外です")
    # 考える過程を <think>…</think> で本文に混ぜてくるモデルがあるので取り除く
    content = re.sub(r"<think>.*?</think>", "", content, flags=re.S).strip()
    if not content:
        if choice.get("finish_reason") == "length":
            raise Fail(5, "出力の上限に達して答えが出ませんでした（--max を増やす）")
        raise Fail(3, f"{label} の答えが空でした")
    return content


def main():
    max_tokens, instruction, paths = parse_args(sys.argv[1:])

    stdin_text = read_stdin(wait=not paths)
    files = []
    for p in paths:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                files.append((os.path.basename(p), f.read()))
        except OSError as e:
            die(1, f"ファイルを読めません: {p} ({e.strerror})")

    check_forbidden(paths, [instruction, stdin_text] + [b for _, b in files])

    message = build_message(instruction, files, stdin_text)
    errors = []
    for name in ORDER:
        try:
            if name not in BACKUPS:
                raise Fail(1, f"DS_ORDER に知らない名前があります: {name}")
            st = backup_settings(name)
        except Fail as e:
            errors.append(e)
            log(f"{e}（次の AI を試します）")
            continue
        if not st:
            continue
        key, model = st
        label, base = BACKUPS[name]["label"], BACKUPS[name]["base"]
        models = [model] + [m for m in BACKUPS[name].get("fallback", []) if m != model]
        for i, m in enumerate(models):
            try:
                log(f"{label}（{m}・無料）に送ります")
                # 同じ会社に別のモデルが残っているときは、長く待たずにそちらへ切り替える
                waits = RETRY_WAITS[:1] if i < len(models) - 1 else None
                print(call_chat(label, base, key, m, message, max_tokens, waits))
                return
            except Fail as e:
                errors.append(e)
                log(f"{e}（次の AI を試します）")
    if not errors:
        die(2, "使える AI がありません（Groq は bash bin/install-ds.sh --add groq）")
    # どれもだめなら最後のエラーで終わる（上限で答えが出なかったときは 5 を優先して --max を増やすよう促す）
    last = next((e for e in errors if e.code == 5), errors[-1])
    die(last.code, str(last))


if __name__ == "__main__":
    main()
