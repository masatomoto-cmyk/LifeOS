#!/usr/bin/env python3
"""ds: 文章を AI に渡して結果の文章を受け取る（読み取り専用）。

無料の GLM（Z.ai の GLM-4.7-Flash）だけを使う。有料のモデル・DeepSeek には送らない。
呼び出し方は従来の ds と同じ:
  cat 資料.txt | ds "要点を10行で"
  ds "2つの違いを表で" a.md b.md
  ds --max 1500 "エラーを原因ごとに" < app.log

終了コード（従来の ds とそろえる）: 2 キー未設定 / 3 API エラー / 4 送信禁止 / 5 上限で答えが出ない
失敗したら Claude が自分で行う（CLAUDE.md）。

設定（環境変数）:
  GLM_API_KEY     Z.ai の API キー（なければ ~/.config/glm/api_key を読む）
  GLM_BASE_URL    既定 https://api.z.ai/api/paas/v4（中国版は https://open.bigmodel.cn/api/paas/v4）
  GLM_MODEL       既定 glm-4.7-flash。無料のモデル（FREE_MODELS）以外は受け付けない
  DS_QUIET=1      送信先の表示（標準エラー）を消す
"""

import json
import os
import re
import select
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
GLM_BASE_URL = os.environ.get("GLM_BASE_URL", "https://api.z.ai/api/paas/v4").rstrip("/")
GLM_MODEL = os.environ.get("GLM_MODEL", "glm-4.7-flash")
# 料金がかからないモデルだけ。ここにないモデル（GLM-5.3-Flash など有料のもの）は使わない
FREE_MODELS = {"glm-4.7-flash", "glm-4.5-flash"}
# API キーを送る先は Z.ai / 智譜の公式ホストだけ（環境変数で別のサーバーに差し替えられてもキーを渡さない）
ALLOWED_HOSTS = {"api.z.ai", "open.bigmodel.cn"}
QUIET = os.environ.get("DS_QUIET") == "1"
DEFAULT_MAX = 800
# GLM-4.7-Flash は考える過程にも出力トークンを使う。無料なので余裕を足して、答えが途中で切れないようにする
THINKING_HEADROOM = 4096
TIMEOUT = 300
# 無料枠は同時に 1 件まで。並列で呼ばれて 429 になったら、この秒数ずつ待ってやり直す
RETRY_WAITS = [3, 6, 12]

# 送信禁止（GLM は中国の企業。CLAUDE.md「DeepSeek・GLM に渡さないもの」）
SECRET_PATTERNS = [
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"\bsk-[A-Za-z0-9_-]{20,}",
    r"\bAKIA[0-9A-Z]{16}\b",
    r"\bgh[pousr]_[A-Za-z0-9]{30,}",
    r"\bgithub_pat_[A-Za-z0-9_]{30,}",
    r"\bxox[abprs]-[A-Za-z0-9-]{10,}",
    r"\bAIza[0-9A-Za-z_-]{35}\b",
    r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.",
    r"(?i)\b(password|passwd|secret|api[_-]?key|access[_-]?token)\s*[:=]\s*\S{6,}",
    r"(マイナンバー|個人番号|口座番号)\D{0,10}\d{4,}",
]


def log(msg):
    if not QUIET:
        print(f"[ds] {msg}", file=sys.stderr)


def die(code, msg):
    print(f"ds: {msg}", file=sys.stderr)
    sys.exit(code)


def parse_args(argv):
    max_tokens = DEFAULT_MAX
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--max" and i + 1 < len(argv):
            try:
                max_tokens = int(argv[i + 1])
            except ValueError:
                die(1, f"--max には数を指定してください: {argv[i + 1]}")
            i += 2
            continue
        rest.append(a)
        i += 1
    if not rest:
        die(1, '使い方: ds [--max N] "指示" [ファイル...] [< 入力]')
    return max_tokens, rest[0], rest[1:]


# 認証情報の置き場所。ファイルとして渡されても送らない
SENSITIVE_DIRS = {".ssh", ".aws", ".gnupg", ".kube", ".docker", ".config"}
SENSITIVE_NAMES = {".env", ".netrc", ".npmrc", ".pgpass", "id_rsa", "id_ed25519", "credentials"}


def check_forbidden(paths, texts):
    # シンボリックリンクで 10_Life を迂回されないよう、実体のパスで調べる
    for p in [os.getcwd()] + [os.path.realpath(p) for p in paths]:
        parts = p.split(os.sep)
        if "10_Life" in parts:
            die(4, f"10_Life 配下は送れません: {p}")
    for p in (os.path.realpath(p) for p in paths):
        parts = p.split(os.sep)
        if SENSITIVE_DIRS & set(parts) or os.path.basename(p) in SENSITIVE_NAMES or os.path.basename(p).startswith(".env"):
            die(4, f"認証情報の置き場所らしいファイルは送れません: {p}")
    for t in texts:
        for pat in SECRET_PATTERNS:
            if re.search(pat, t):
                die(4, "秘密情報らしき内容が含まれるため送りません")


def read_glm_key():
    key = os.environ.get("GLM_API_KEY", "").strip()
    if key:
        return key
    try:
        with open(os.path.join(HOME, ".config/glm/api_key"), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def read_stdin(wait):
    """標準入力を読む。ファイルを渡したときは、入力がすぐ来なければ待たない（止まったままになるのを防ぐ）。"""
    if sys.stdin.isatty():
        return ""
    if not wait:
        ready, _, _ = select.select([sys.stdin], [], [], 0.5)
        if not ready:
            return ""
    return sys.stdin.read()


def build_message(instruction, files, stdin_text):
    parts = [instruction]
    for name, body in files:
        parts.append(f"\n--- ファイル: {name} ---\n{body}")
    if stdin_text:
        parts.append(f"\n--- 入力 ---\n{stdin_text}")
    return "\n".join(parts)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def call_glm(key, message, max_tokens):
    body = json.dumps({
        "model": GLM_MODEL,
        "messages": [{"role": "user", "content": message}],
        "max_tokens": max_tokens + THINKING_HEADROOM,
        "stream": False,
    }).encode("utf-8")
    url = f"{GLM_BASE_URL}/chat/completions"
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "https" or parsed.hostname not in ALLOWED_HOSTS:
        die(1, f"GLM_BASE_URL は {', '.join(sorted(ALLOWED_HOSTS))} の https だけ使えます")
    req = urllib.request.Request(
        url,
        data=body,
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
    )
    # リダイレクトは辿らない（キーを別のホストへ持ち出さないため）
    opener = urllib.request.build_opener(_NoRedirect)
    for wait in RETRY_WAITS + [None]:
        try:
            with opener.open(req, timeout=TIMEOUT) as res:
                data = json.load(res)
            break
        except urllib.error.HTTPError as e:
            if e.code == 429 and wait is not None:
                log(f"同時実行の上限のため {wait} 秒待ってやり直します")
                time.sleep(wait)
                continue
            detail = e.read().decode("utf-8", "replace")[:200]
            die(3, f"GLM エラー {e.code}: {detail}")
        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as e:
            die(3, f"GLM に接続できません: {e}")

    try:
        choice = data["choices"][0]
        content = (choice["message"].get("content") or "").strip()
    except (KeyError, IndexError, TypeError):
        die(3, "GLM の応答の形が想定外です")
    if not content:
        if choice.get("finish_reason") == "length":
            die(5, "出力の上限に達して答えが出ませんでした（--max を増やす）")
        die(3, "GLM の答えが空でした")
    return content


def main():
    max_tokens, instruction, paths = parse_args(sys.argv[1:])

    if GLM_MODEL not in FREE_MODELS:
        die(1, f"無料のモデルだけ使えます（{', '.join(sorted(FREE_MODELS))}）: {GLM_MODEL}")

    stdin_text = read_stdin(wait=not paths)
    files = []
    for p in paths:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                files.append((os.path.basename(p), f.read()))
        except OSError as e:
            die(1, f"ファイルを読めません: {p} ({e.strerror})")

    check_forbidden(paths, [instruction, stdin_text] + [b for _, b in files])

    key = read_glm_key()
    if not key:
        die(2, "GLM の API キーがありません（~/.config/glm/api_key か GLM_API_KEY）")

    log(f"GLM（{GLM_MODEL}・無料）に送ります")
    print(call_glm(key, build_message(instruction, files, stdin_text), max_tokens))


if __name__ == "__main__":
    main()
